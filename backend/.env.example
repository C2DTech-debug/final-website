# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/c2dtech?retryWrites=true&w=majority

# Frontend origins (for CORS). Comma-separated list allowed; this list is
# merged with the always-allowed defaults below (localhost dev + c2dtech.com
# production + legacy Vercel admin) — it can only ADD more origins.
#   always allowed: http://localhost:3000, http://localhost:5173,
#                   https://c2dtech.com, https://www.c2dtech.com,
#                   https://c2dtech-frontend.vercel.app
CLIENT_URL=http://localhost:3000

# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=c2d-tech-api

# API base path
API_PREFIX=/api/v1

# Cookie options
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# SMTP (Nodemailer) — used for contact notifications & acknowledgements
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="C2D Tech <no-reply@c2dtech.example.com>"
MAIL_ADMIN_TO=admin@c2dtech.example.com

# Cloudinary — REQUIRED in production. The app is cloud-only: every uploaded
# file (media, resumes) is stored on Cloudinary and served from its CDN.
# Without these, uploads are rejected in production (never stored locally).
# In development only, files fall back to the local /uploads directory.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google reCAPTCHA (optional) — verify tokens on public forms
RECAPTCHA_SECRET=

# WhatsApp notification (optional) — phone number that receives contact alerts
WHATSAPP_ADMIN_NUMBER=

# Razorpay — payment links (payments module). WEBHOOK_SECRET signs the
# POST /api/v1/payments/webhook payloads. Leave all three empty to run with
# payment-link creation disabled (the module still stores/views requests).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business Cloud API — sends approved payment-link templates.
# ACCESS_TOKEN/PHONE_NUMBER_ID/TEMPLATE_NAME are required to actually send.
# WEBHOOK_VERIFY_TOKEN + APP_SECRET secure GET/POST /api/v1/whatsapp/webhook.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=payment_link
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v22.0

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Maintenance mode — when true, public API returns 503
MAINTENANCE_MODE=false

# Initial Super Admin bootstrap (used by npm run seed:admin)
ADMIN_NAME=C2D Admin
ADMIN_EMAIL=admin@c2dtech.example.com
ADMIN_PASSWORD=ChangeMe123!
