# Frontend environment. Copy to .env.local for local dev, or pass as build args in Docker.
# Note: NEXT_PUBLIC_* vars are inlined at build time.

# Base URL of the backend API. For local dev use http://localhost:5000.
# In Docker, point at the backend service (http://backend:5000) — browser-side
# calls stay same-origin and are proxied by next.config.mjs rewrites.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public site URL (used for sitemap, canonical links, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google reCAPTCHA v2 site key (optional — leave blank to disable)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Not used (kept blank)
AUTH_SECRET=
